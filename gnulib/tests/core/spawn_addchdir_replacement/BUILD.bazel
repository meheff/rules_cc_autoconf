    out = "present_native_types.h",
    mode = "subst",
    template = "subst.h.in",
    deps = [":present_native_types_config"],
)

diff_test(
    name = "present_native_types_test",
    file1 = "golden_replacement.h.in",
    file2 = ":present_native_types_header",
)

