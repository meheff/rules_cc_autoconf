# Windows has no native spawn API and therefore no conflicting native declaration.
autoconf_cache(
    name = "missing_windows_types_inputs",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "ac_cv_func_posix_spawn_file_actions_addchdir",
            code = "#error Simulated missing function",
            language = "c",
        ),
        checks.AC_DEFINE("REPLACE_POSIX_SPAWN", 1),
        checks.AC_SUBST("HAVE_POSIX_SPAWN", 0),
    ],
)

autoconf_cache(
    name = "missing_windows_types_config",
