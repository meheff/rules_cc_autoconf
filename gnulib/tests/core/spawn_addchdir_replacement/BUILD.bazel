load("//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("//autoconf:autoconf_toolchain.bzl", "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//autoconf/tests:diff_test.bzl", "diff_test")
load("//gnulib/m4/posix_spawn_faction_addchdir:replacement.bzl", "addchdir_replacement_check")

# A missing addchdir needs no symbol replacement when native spawn types are used.
autoconf_cache(
    name = "missing_native_types_inputs",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "ac_cv_func_posix_spawn_file_actions_addchdir",
            code = "#error Simulated missing function",
            language = "c",
        ),
        checks.AC_DEFINE("REPLACE_POSIX_SPAWN", 0),
        checks.AC_SUBST("HAVE_POSIX_SPAWN", 1),
    ],
)

autoconf_cache(
    name = "missing_native_types_config",
    checks = [addchdir_replacement_check()],
    deps = [":missing_native_types_inputs"],
)

autoconf_hdr(
    name = "missing_native_types_header",
    out = "missing_native_types.h",
    mode = "subst",
    template = "subst.h.in",
    deps = [":missing_native_types_config"],
)

diff_test(
    name = "missing_native_types_test",
    file1 = "golden_native.h.in",
    file2 = ":missing_native_types_header",
)

# Regression: a failed addchdir probe must not mix native declarations with replacement spawn types.
autoconf_cache(
    name = "missing_replacement_types_inputs",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "ac_cv_func_posix_spawn_file_actions_addchdir",
            code = "#error Simulated missing function",
            language = "c",
        ),
        checks.AC_DEFINE("REPLACE_POSIX_SPAWN", 1),
        checks.AC_SUBST("HAVE_POSIX_SPAWN", 1),
    ],
)

autoconf_cache(
    name = "missing_replacement_types_config",
    checks = [addchdir_replacement_check()],
    deps = [":missing_replacement_types_inputs"],
)

autoconf_hdr(
    name = "missing_replacement_types_header",
    out = "missing_replacement_types.h",
    mode = "subst",
    template = "subst.h.in",
    deps = [":missing_replacement_types_config"],
)

diff_test(
    name = "missing_replacement_types_test",
    file1 = "golden_replacement.h.in",
    file2 = ":missing_replacement_types_header",
)

# An available addchdir uses the gnulib replacement even with native spawn types.
autoconf_cache(
    name = "present_native_types_inputs",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "ac_cv_func_posix_spawn_file_actions_addchdir",
            code = "int main(void) { return 0; }",
            language = "c",
        ),
        checks.AC_DEFINE("REPLACE_POSIX_SPAWN", 0),
        checks.AC_SUBST("HAVE_POSIX_SPAWN", 1),
    ],
)

autoconf_cache(
    name = "present_native_types_config",
    checks = [addchdir_replacement_check()],
    deps = [":present_native_types_inputs"],
)

autoconf_hdr(
